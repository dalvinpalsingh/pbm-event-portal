{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/pbm-eventportal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "CompetitionRules": {
    "JudgingCriteriaCountOptions": [
      0,
      1,
      2,
      3,
      4
    ],
    "JudgeCountOptions": [
      1,
      2,
      3
    ],
    "Individual": {
      "MaxDefaultWinnerCount": 5
    },
    "Team": {
      "MaxDefaultWinnerCount": 5
    }
  },
  "CompetitionCategoryRules": {
    "Individual": {
      "MaxWinnerCount": 5,
      "DefaultMaxParticipantsPerTeam": 2
    },
    "Team": {
      "MaxWinnerCount": 5,
      "DefaultMaxEntriesPerTeam": 1,
      "AllowedTeamSizes": [
        2,
        3
      ]
    }
  },
  "PointsSchemeRules": {
    "MinWinnerCount": 1,
    "MaxWinnerCount": 5
  },
  "AllowedHosts": "*"
}
