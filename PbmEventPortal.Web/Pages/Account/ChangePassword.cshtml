@page
@model PbmEventPortal.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";

    var mustChangePassword = string.Equals(
        User.FindFirst("MustChangePassword")?.Value,
        "true",
        StringComparison.OrdinalIgnoreCase);

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var hasSuccessMessage = !string.IsNullOrWhiteSpace(Model.SuccessMessage);
    var hasServerErrors = serverErrors.Count > 0;
    var shouldShowResultModal = hasSuccessMessage || hasServerErrors;

    var modalTitle = hasSuccessMessage
        ? "Password changed"
        : "Password change failed";

    var modalMessage = hasSuccessMessage
        ? Model.SuccessMessage
        : "Please review the following and try again.";

    var modalCssClass = hasSuccessMessage
        ? "app-result-modal-success"
        : "app-result-modal-danger";

    var modalIcon = hasSuccessMessage
        ? "bi-check-circle-fill"
        : "bi-exclamation-triangle-fill";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="app-page-header text-center">
            <p class="app-eyebrow">Account security</p>
            <h1>Change Password</h1>
            <p>
                Update your password.
            </p>
        </div>

        <div class="app-card">
            @if (mustChangePassword)
            {
                <div class="app-alert app-alert-warning mb-3">
                    <div class="fw-semibold mb-1">
                        Password change required
                    </div>
                    <div>
                        You are using a temporary password. Please create a new password before continuing to the portal.
                    </div>
                </div>
            }
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.CurrentPassword" class="form-label"></label>

                    <div class="app-password-input-wrap">
                        <input asp-for="Input.CurrentPassword" class="form-control app-password-input" autocomplete="current-password" />
                        <button type="button"
                                class="app-password-toggle"
                                data-password-toggle-for="Input_CurrentPassword"
                                aria-label="Hold to show current password">
                            <i class="bi bi-eye-slash" data-password-toggle-icon aria-hidden="true"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label"></label>

                    <div class="app-password-input-wrap">
                        <input asp-for="Input.NewPassword" class="form-control app-password-input" autocomplete="new-password" />
                        <button type="button"
                                class="app-password-toggle"
                                data-password-toggle-for="Input_NewPassword"
                                aria-label="Hold to show new password">
                            <i class="bi bi-eye-slash" data-password-toggle-icon aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="app-password-policy mt-2" aria-live="polite">
                        <div class="fw-semibold mb-2">Password must:</div>

                        <ul class="app-password-checklist mb-0">
                            <li data-password-rule="length">
                                <span class="app-password-rule-icon">✕</span>
                                Be 8 to 64 characters
                            </li>
                            <li data-password-rule="uppercase">
                                <span class="app-password-rule-icon">✕</span>
                                Contain at least one uppercase letter
                            </li>
                            <li data-password-rule="lowercase">
                                <span class="app-password-rule-icon">✕</span>
                                Contain at least one lowercase letter
                            </li>
                            <li data-password-rule="number">
                                <span class="app-password-rule-icon">✕</span>
                                Contain at least one number
                            </li>
                            <li data-password-rule="symbol">
                                <span class="app-password-rule-icon">✕</span>
                                Contain at least one symbol
                            </li>
                        </ul>
                    </div>

                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmNewPassword" class="form-label"></label>

                    <div class="app-password-input-wrap">
                        <input asp-for="Input.ConfirmNewPassword" class="form-control app-password-input" autocomplete="new-password" />
                        <button type="button"
                                class="app-password-toggle"
                                data-password-toggle-for="Input_ConfirmNewPassword"
                                aria-label="Hold to show confirm new password">
                            <i class="bi bi-eye-slash" data-password-toggle-icon aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="app-password-policy mt-2">
                        <ul class="app-password-checklist mb-0">
                            <li data-password-rule="match">
                                <span class="app-password-rule-icon">✕</span>
                                <span data-password-rule-text="match">New password and Confirm new password do not match</span>
                            </li>
                        </ul>
                    </div>

                    <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        Change Password
                    </button>

                    <a class="btn btn-outline-secondary" asp-page="/Index">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="changePasswordResultModal" tabindex="-1" aria-labelledby="changePasswordResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>

                        <h2 class="modal-title fs-5" id="changePasswordResultModalLabel">
                            @modalTitle
                        </h2>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="@(hasServerErrors ? "mb-2" : "mb-0")">
                        @modalMessage
                    </p>

                    @if (hasServerErrors)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>

                <div class="modal-footer">
                    @if (hasSuccessMessage)
                    {
                        <a class="btn btn-primary" asp-page="/Index">
                            Back to Home
                        </a>

                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Stay here
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                            Okay, I’ll fix it
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const newPasswordInput = document.getElementById("Input_NewPassword");
            const confirmPasswordInput = document.getElementById("Input_ConfirmNewPassword");

            const rules = {
                length: (value) => value.length >= 8 && value.length <= 64,
                uppercase: (value) => /[A-Z]/.test(value),
                lowercase: (value) => /[a-z]/.test(value),
                number: (value) => /\d/.test(value),
                symbol: (value) => /[\p{P}\p{S}]/u.test(value),
                match: () => {
                    const newPassword = newPasswordInput?.value ?? "";
                    const confirmPassword = confirmPasswordInput?.value ?? "";

                    return newPassword.length > 0 && newPassword === confirmPassword;
                }
            };

            function updateRule(ruleName, isValid) {
                const item = document.querySelector(`[data-password-rule="${ruleName}"]`);

                if (!item) {
                    return;
                }

                const icon = item.querySelector(".app-password-rule-icon");

                item.classList.toggle("is-valid", isValid);
                item.classList.toggle("is-invalid", !isValid);

                if (icon) {
                    icon.textContent = isValid ? "✓" : "✕";
                }

                if (ruleName === "match") {
                    const text = item.querySelector('[data-password-rule-text="match"]');

                    if (text) {
                        text.textContent = isValid
                            ? "New password matches Confirm new password"
                            : "New password and Confirm new password do not match";
                    }
                }
            }

            function updateChecklist() {
                const newPassword = newPasswordInput?.value ?? "";

                updateRule("length", rules.length(newPassword));
                updateRule("uppercase", rules.uppercase(newPassword));
                updateRule("lowercase", rules.lowercase(newPassword));
                updateRule("number", rules.number(newPassword));
                updateRule("symbol", rules.symbol(newPassword));
                updateRule("match", rules.match());
            }

            newPasswordInput?.addEventListener("input", updateChecklist);
            confirmPasswordInput?.addEventListener("input", updateChecklist);

            updateChecklist();
        })();
    </script>

    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("changePasswordResultModal");

                if (!modalElement) {
                    return;
                }

                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        </script>
    }
}