@page
@model PbmEventPortal.Web.Pages.Admin.ScoreSheets.IndexModel
@{
    ViewData["Title"] = "Score Sheets";

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowResultModal = Model.ResultIsSuccess.HasValue;
    var resultIsSuccess = Model.ResultIsSuccess == true;
    var modalCssClass = resultIsSuccess ? "app-result-modal-success" : "app-result-modal-danger";
    var modalIcon = resultIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill";
}

<div class="app-page-header">
    <p class="app-eyebrow">Score Sheet Setup</p>
    <h1>Score Sheets</h1>
    <p>
        Open a judge-style score sheet for any competition, with admin override access.
    </p>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/Index">
            Back to Admin
        </a>
    </div>
</div>

<div class="app-card mb-3">
    <h2>Open Score Sheet</h2>
    <form method="get" class="row g-3 align-items-end" id="scoreSheetSelectorForm">
        <div class="col-md-5">
            <label asp-for="CompetitionYearId" class="form-label">Competition year</label>
            <select asp-for="CompetitionYearId" asp-items="Model.CompetitionYearOptions" class="form-select" id="competitionYearSelect" data-searchable-select="true" data-searchable-placeholder="Search year..."></select>
        </div>
        <div class="col-md-5">
            <label asp-for="CompetitionCategoryId" class="form-label">Competition / Category</label>
            <select asp-for="CompetitionCategoryId" asp-items="Model.CompetitionCategoryOptions" class="form-select" id="competitionCategorySelect" data-searchable-select="true" data-searchable-placeholder="Search category..."></select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <a class="btn btn-danger w-100" asp-page="/Admin/ScoreSheets/Index">Reset</a>
        </div>
    </form>
</div>

<div id="scoreSheetWorkspaceContainer">
    <partial name="_ScoreSheetWorkspace" model="Model.Workspace" />
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="scoreSheetResultModal" tabindex="-1" aria-labelledby="scoreSheetResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>
                        <h2 class="modal-title fs-5" id="scoreSheetResultModalLabel">@Model.ResultTitle</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="@(serverErrors.Count > 0 ? "mb-2" : "mb-0")">@Model.ResultMessage</p>
                    @if (serverErrors.Count > 0)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Okay</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const competitionYearSelect = document.getElementById("competitionYearSelect");
            const competitionCategorySelect = document.getElementById("competitionCategorySelect");
            const workspaceContainer = document.getElementById("scoreSheetWorkspaceContainer");

            function refreshEnhancedSelect(select) {
                if (!select) return;
                select.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function selectCurrentCompetitionYearIfEmpty() {
                if (!competitionYearSelect || competitionYearSelect.value) return false;

                const currentYear = new Date().getFullYear().toString();
                const currentYearOption = Array.from(competitionYearSelect.options)
                    .find(option => option.value && option.textContent.includes(currentYear));

                if (!currentYearOption) return false;

                competitionYearSelect.value = currentYearOption.value;
                refreshEnhancedSelect(competitionYearSelect);
                return true;
            }

            function formatCategoryLabel(rawCategory) {
                const category = (rawCategory || "").trim();
                if (!category) return "";

                return category
                    .replace(/_/g, " ")
                    .toLowerCase()
                    .split(" ")
                    .filter(Boolean)
                    .map(word => word.length <= 2 ? word.toUpperCase() : word.charAt(0).toUpperCase() + word.slice(1))
                    .join(" ");
            }

            function normalizeEventGroupName(rawGroupName) {
                const groupName = (rawGroupName || "").replaceAll("-", "").trim().toUpperCase();

                if (groupName.includes("INDIVIDUAL")) return "-- INDIVIDUAL EVENTS --";
                if (groupName.includes("TEAM")) return "-- TEAM EVENTS --";
                if (!groupName) return "-- OTHER --";

                return `-- ${groupName} --`;
            }

            function getCategoryDisplayParts(rawText) {
                const text = (rawText || "").trim();
                const parts = text.split(" / ");

                if (parts.length < 2) {
                    return {
                        competitionName: text,
                        categoryName: text,
                        selectedText: text
                    };
                }

                const competitionName = parts[0].trim();
                const categoryName = formatCategoryLabel(parts.slice(1).join(" / "));

                return {
                    competitionName,
                    categoryName,
                    selectedText: `${competitionName} / ${categoryName}`
                };
            }

            function enrichCategoryOption(option, explicitGroupName) {
                if (!option || !option.value) return;

                const parts = getCategoryDisplayParts(option.textContent);
                const groupName = explicitGroupName || option.parentElement?.label || "";

                option.textContent = parts.selectedText;
                option.dataset.searchGroupLabel = normalizeEventGroupName(groupName);
                option.dataset.searchParentText = parts.competitionName;
                option.dataset.searchChildText = parts.categoryName;
            }

            function enrichCategoryOptionsForDisplay() {
                if (!competitionCategorySelect) return;

                Array.from(competitionCategorySelect.options)
                    .filter(option => option.value)
                    .forEach(option => enrichCategoryOption(option));
            }

            function getCategoryDropdownElements() {
                const wrapper = competitionCategorySelect?.nextElementSibling;
                if (!wrapper?.classList?.contains("app-searchable-select")) return null;

                return {
                    wrapper,
                    button: wrapper.querySelector(".app-searchable-select-button"),
                    searchInput: wrapper.querySelector(".app-searchable-select-search"),
                    optionsContainer: wrapper.querySelector(".app-searchable-select-options"),
                    menu: wrapper.querySelector(".app-searchable-select-menu")
                };
            }

            function renderCategoryHierarchyOptions() {
                const elements = getCategoryDropdownElements();
                if (!elements?.button || !elements.searchInput || !elements.optionsContainer || !competitionCategorySelect) return;

                const filter = elements.searchInput.value.trim().toLowerCase();
                const selectedOption = Array.from(competitionCategorySelect.options).find(option => option.value === competitionCategorySelect.value);

                elements.button.textContent = selectedOption?.textContent?.trim() || "Select competition/category...";
                elements.button.classList.toggle("text-muted", !competitionCategorySelect.value);
                elements.optionsContainer.innerHTML = "";

                const placeholderOption = Array.from(competitionCategorySelect.options).find(option => !option.value && !option.disabled && !option.hidden);
                if (placeholderOption && !filter) {
                    const placeholderButton = document.createElement("button");
                    placeholderButton.type = "button";
                    placeholderButton.className = "dropdown-item app-searchable-select-option text-muted";
                    placeholderButton.textContent = placeholderOption.textContent;
                    placeholderButton.classList.toggle("active", !competitionCategorySelect.value);
                    placeholderButton.addEventListener("click", (event) => {
                        event.stopPropagation();
                        competitionCategorySelect.value = "";
                        competitionCategorySelect.dispatchEvent(new Event("change", { bubbles: true }));
                    });
                    elements.optionsContainer.appendChild(placeholderButton);
                }

                const categoryOptions = Array.from(competitionCategorySelect.options)
                    .filter(option => option.value && !option.disabled && !option.hidden)
                    .map(option => ({
                        option,
                        groupLabel: option.dataset.searchGroupLabel || normalizeEventGroupName(option.parentElement?.label || ""),
                        competitionName: option.dataset.searchParentText || getCategoryDisplayParts(option.textContent).competitionName,
                        categoryName: option.dataset.searchChildText || getCategoryDisplayParts(option.textContent).categoryName,
                        searchText: `${option.textContent} ${option.dataset.searchGroupLabel || ""} ${option.dataset.searchParentText || ""} ${option.dataset.searchChildText || ""}`.toLowerCase()
                    }))
                    .filter(item => !filter || item.searchText.includes(filter));

                if (categoryOptions.length === 0) {
                    const empty = document.createElement("div");
                    empty.className = "dropdown-item text-muted small";
                    empty.textContent = "No matches found";
                    elements.optionsContainer.appendChild(empty);
                    return;
                }

                const groupedByEvent = new Map();
                categoryOptions.forEach(item => {
                    if (!groupedByEvent.has(item.groupLabel)) groupedByEvent.set(item.groupLabel, new Map());

                    const competitionGroup = groupedByEvent.get(item.groupLabel);
                    if (!competitionGroup.has(item.competitionName)) competitionGroup.set(item.competitionName, []);
                    competitionGroup.get(item.competitionName).push(item);
                });

                groupedByEvent.forEach((competitionGroup, groupLabel) => {
                    const eventHeader = document.createElement("div");
                    eventHeader.className = "dropdown-header text-muted fw-semibold small px-2 pt-2";
                    eventHeader.textContent = groupLabel;
                    elements.optionsContainer.appendChild(eventHeader);

                    competitionGroup.forEach((items, competitionName) => {
                        const competitionHeader = document.createElement("div");
                        competitionHeader.className = "dropdown-item-text fw-semibold px-3 pt-1 pb-1";
                        competitionHeader.textContent = competitionName;
                        elements.optionsContainer.appendChild(competitionHeader);

                        items.forEach(item => {
                            const categoryButton = document.createElement("button");
                            categoryButton.type = "button";
                            categoryButton.className = "dropdown-item app-searchable-select-option ps-4";
                            categoryButton.textContent = item.categoryName;
                            categoryButton.classList.toggle("active", item.option.value === competitionCategorySelect.value);
                            categoryButton.addEventListener("click", () => {
                                competitionCategorySelect.value = item.option.value;
                                competitionCategorySelect.dispatchEvent(new Event("change", { bubbles: true }));
                                bootstrap.Dropdown.getOrCreateInstance(elements.button).hide();
                            });
                            elements.optionsContainer.appendChild(categoryButton);
                        });
                    });
                });
            }

            function setupCategoryDropdownHierarchy() {
                enrichCategoryOptionsForDisplay();
                const elements = getCategoryDropdownElements();
                if (!elements?.button || !elements.searchInput || !elements.optionsContainer) return;

                if (competitionCategorySelect.dataset.categoryHierarchyEnhanced !== "true") {
                    competitionCategorySelect.dataset.categoryHierarchyEnhanced = "true";
                    elements.menu?.addEventListener("click", event => event.stopPropagation());
                    elements.button.addEventListener("click", () => setTimeout(renderCategoryHierarchyOptions, 0));
                    elements.searchInput.addEventListener("input", () => setTimeout(renderCategoryHierarchyOptions, 0));
                    competitionCategorySelect.addEventListener("change", () => setTimeout(renderCategoryHierarchyOptions, 0));
                }

                renderCategoryHierarchyOptions();
            }

            function resetCategorySelect(message) {
                if (!competitionCategorySelect) return;
                competitionCategorySelect.innerHTML = "";
                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = message;
                competitionCategorySelect.appendChild(placeholder);
                competitionCategorySelect.value = "";
                setupCategoryDropdownHierarchy();
                refreshEnhancedSelect(competitionCategorySelect);
            }

            function appendCategoryOption(groupElement, option) {
                const optionElement = document.createElement("option");
                optionElement.value = option.value;
                optionElement.textContent = option.text;
                enrichCategoryOption(optionElement, option.groupName);
                groupElement.appendChild(optionElement);
            }

            async function loadCategoriesForYear(yearId) {
                if (!competitionCategorySelect) return;
                if (!yearId) {
                    resetCategorySelect("Select competition year first...");
                    await loadScoreSheetWorkspace();
                    return;
                }

                resetCategorySelect("Loading categories...");

                const response = await fetch(`?handler=CompetitionCategories&competitionYearId=${encodeURIComponent(yearId)}`, {
                    headers: { "Accept": "application/json" }
                });

                if (!response.ok) {
                    resetCategorySelect("Unable to load categories");
                    await loadScoreSheetWorkspace();
                    return;
                }

                const options = await response.json();
                competitionCategorySelect.innerHTML = "";

                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = options.length === 0 ? "No competition categories found" : "Select competition/category...";
                competitionCategorySelect.appendChild(placeholder);

                const groups = new Map();
                options.forEach(option => {
                    const groupName = option.groupName || "Other";
                    if (!groups.has(groupName)) {
                        const group = document.createElement("optgroup");
                        group.label = groupName;
                        groups.set(groupName, group);
                        competitionCategorySelect.appendChild(group);
                    }
                    appendCategoryOption(groups.get(groupName), option);
                });

                competitionCategorySelect.value = "";
                setupCategoryDropdownHierarchy();
                refreshEnhancedSelect(competitionCategorySelect);
                await loadScoreSheetWorkspace();
            }

            async function loadScoreSheetWorkspace() {
                if (!workspaceContainer) return;

                const yearId = competitionYearSelect?.value || "";
                const categoryId = competitionCategorySelect?.value || "";
                const url = `?handler=ScoreSheetWorkspace&competitionYearId=${encodeURIComponent(yearId)}&competitionCategoryId=${encodeURIComponent(categoryId)}`;

                workspaceContainer.innerHTML = `<div class="app-card"><p class="text-muted mb-0">Loading score sheet...</p></div>`;
                const response = await fetch(url, { headers: { "Accept": "text/html" } });

                if (!response.ok) {
                    workspaceContainer.innerHTML = `<div class="app-card"><p class="text-danger mb-0">Unable to load score sheet.</p></div>`;
                    return;
                }

                workspaceContainer.innerHTML = await response.text();
                window.FormHelpers?.setupSearchableSelects?.(workspaceContainer);
                window.FormHelpers?.setupBoundedNumberInputs?.(workspaceContainer);
                initializeScoreSheetWorkspace();
            }

            function initializeScoreSheetWorkspace() {
                window.FormHelpers?.setupBoundedNumberInputs?.(workspaceContainer);
                workspaceContainer?.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(element => new bootstrap.Tooltip(element));

                function refreshTotals() {
                    const teamTotals = new Map();

                    workspaceContainer?.querySelectorAll("[data-score-row='true']").forEach(row => {
                        let memberTotal = 0;
                        row.querySelectorAll("[data-score-input='true']").forEach(input => {
                            window.FormHelpers?.sanitizeBoundedNumberInput?.(input, false);
                            const value = Number(input.value || 0);
                            if (!Number.isNaN(value)) memberTotal += value;
                        });

                        const entryId = row.getAttribute("data-entry-id") || "";
                        teamTotals.set(entryId, (teamTotals.get(entryId) || 0) + memberTotal);

                        const memberTotalCell = row.querySelector("[data-member-total='true']");
                        if (memberTotalCell) memberTotalCell.textContent = memberTotal.toFixed(2).replace(/\.00$/, "");
                    });

                    workspaceContainer?.querySelectorAll("[data-score-row='true']").forEach(row => {
                        const entryId = row.getAttribute("data-entry-id") || "";
                        const teamTotalCell = row.querySelector("[data-team-total='true']");
                        if (teamTotalCell && teamTotalCell.textContent.trim() !== "-") {
                            const teamTotal = teamTotals.get(entryId) || 0;
                            teamTotalCell.textContent = teamTotal.toFixed(2).replace(/\.00$/, "");
                        }
                    });
                }

                workspaceContainer?.querySelectorAll("[data-score-input='true']").forEach(input => input.addEventListener("input", refreshTotals));
                refreshTotals();
            }

            competitionYearSelect?.addEventListener("change", () => {
                loadCategoriesForYear(competitionYearSelect.value);
            });

            competitionCategorySelect?.addEventListener("change", () => {
                loadScoreSheetWorkspace();
            });

            enrichCategoryOptionsForDisplay();
            window.FormHelpers?.setupSearchableSelects?.();
            setupCategoryDropdownHierarchy();

            if (selectCurrentCompetitionYearIfEmpty()) {
                loadCategoriesForYear(competitionYearSelect.value);
            }

            initializeScoreSheetWorkspace();
        })();
    </script>
    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("scoreSheetResultModal");
                if (modalElement) new bootstrap.Modal(modalElement).show();
            });
        </script>
    }
}
