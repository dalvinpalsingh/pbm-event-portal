@page "{id:guid}"
@model PbmEventPortal.Web.Pages.Admin.UserProfiles.DetailsModel
@{
    ViewData["Title"] = "User Profile Details";
    var user = Model.UserProfile;

    var roleServerErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowRoleResultModal = !string.IsNullOrWhiteSpace(Model.RoleAssignmentResultTitle);
    var roleResultIsSuccess = Model.RoleAssignmentResultStatus == "success";

    var roleModalCssClass = roleResultIsSuccess
        ? "app-result-modal-success"
        : "app-result-modal-danger";

    var roleModalIcon = roleResultIsSuccess
        ? "bi-check-circle-fill"
        : "bi-exclamation-triangle-fill";
}

<div class="app-page-header">
    <p class="app-eyebrow">Administration</p>
    <h1>User Profile Details</h1>
    <p>
        View full system user information.
    </p>

    @if (user != null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/UserProfiles/Index">
                Back to User Profiles
            </a>

            <a class="btn btn-primary btn-sm"
               asp-page="/Admin/UserProfiles/Edit"
               asp-route-id="@user.Id">
                Edit User
            </a>
        </div>
    }
    else
    {
        <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/UserProfiles/Index">
            Back to User Profiles
        </a>
    }
</div>

@if (user != null)
{
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="app-card">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <h2 class="mb-1">@user.FullNameAsPerId</h2>

                        @if (!string.IsNullOrWhiteSpace(user.FullNameGurmukhi))
                        {
                            <p class="mb-0 text-muted">@user.FullNameGurmukhi</p>
                        }
                    </div>

                    <span class="app-pill">@user.StatusDisplay</span>
                </div>

                <div class="table-responsive">
                    <table class="table app-table align-middle">
                        <tbody>
                            <tr>
                                <th>User ID</th>
                                <td>@user.Id</td>
                            </tr>
                            <tr>
                                <th>ID Type</th>
                                <td>@user.IdType</td>
                            </tr>
                            <tr>
                                <th>ID Number</th>
                                <td>@user.IdNumber</td>
                            </tr>

                            @if (user.PassportExpiryDate != null)
                            {
                                <tr>
                                    <th>Passport Expiry Date</th>
                                    <td>@user.PassportExpiryDate.Value.ToString("dd MMM yyyy")</td>
                                </tr>
                            }

                            <tr>
                                <th>Gender</th>
                                <td>@user.GenderDisplay</td>
                            </tr>
                            <tr>
                                <th>Date of Birth</th>
                                <td>@user.DateOfBirth.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>@user.Email</td>
                            </tr>
                            <tr>
                                <th>Mobile Number</th>
                                <td>@user.MobileNumber</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a class="btn btn-success btn-sm" href="@user.WhatsAppUrl" target="_blank" rel="noopener">
                        <i class="bi bi-whatsapp me-1" aria-hidden="true"></i>
                        WhatsApp
                    </a>

                    <a class="btn btn-primary btn-sm" href="@user.CallUrl">
                        <i class="bi bi-telephone-fill me-1" aria-hidden="true"></i>
                        Call
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="app-card mb-3">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h2 class="mb-1">Role Assignments</h2>
                        <p class="mb-0 text-muted">
                            Roles currently assigned to this user.
                        </p>
                    </div>

                    <span class="app-pill">@user.RoleAssignments.Count</span>
                </div>

                @if (user.RoleAssignments.Count == 0)
                {
                    <p class="text-muted mb-0">No roles assigned.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var roleAssignment in user.RoleAssignments)
                        {
                            var canAssignTeamToTeamManager =
                            roleAssignment.RoleCode == "TEAM_MANAGER" &&
                            roleAssignment.IsActive &&
                            roleAssignment.IsVerified &&
                            roleAssignment.TeamId == null;

                            var canRemoveTeamFromTeamManager =
                            roleAssignment.RoleCode == "TEAM_MANAGER" &&
                            roleAssignment.TeamId != null;

                            var assignTeamModalId = $"assignTeamToTeamManagerModal-{roleAssignment.Id}";
                            var assignTeamModalLabelId = $"assignTeamToTeamManagerModalLabel-{roleAssignment.Id}";

                            var removeTeamModalId = $"removeTeamFromTeamManagerModal-{roleAssignment.Id}";
                            var removeTeamModalLabelId = $"removeTeamFromTeamManagerModalLabel-{roleAssignment.Id}";

                            <div class="app-mini-card">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">@roleAssignment.RoleName</div>
                                        <div class="text-muted small">@roleAssignment.RoleCode</div>
                                    </div>

                                    <span class="app-pill">@roleAssignment.StatusDisplay</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(roleAssignment.RoleDescription))
                                {
                                    <p class="text-muted small mb-2 mt-2">
                                        @roleAssignment.RoleDescription
                                    </p>
                                }

                                <div class="small">
                                    <div><span class="text-muted">Scope:</span> @roleAssignment.RoleScope</div>
                                    <div><span class="text-muted">Team:</span> @roleAssignment.TeamDisplay</div>
                                    <div><span class="text-muted">Primary:</span> @roleAssignment.PrimaryDisplay</div>
                                    <div><span class="text-muted">Verified:</span> @roleAssignment.VerifiedDisplay</div>
                                </div>

                                @if (canAssignTeamToTeamManager || canRemoveTeamFromTeamManager)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        @if (canAssignTeamToTeamManager)
                                        {
                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#@assignTeamModalId">
                                                Assign Team
                                            </button>
                                        }

                                        @if (canRemoveTeamFromTeamManager)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#@removeTeamModalId">
                                                Remove Team
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (canAssignTeamToTeamManager)
                            {
                                <div class="modal fade" id="@assignTeamModalId" tabindex="-1" aria-labelledby="@assignTeamModalLabelId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content app-result-modal">
                                            <div class="modal-header">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-people-fill app-result-modal-icon" aria-hidden="true"></i>
                                                    <h2 class="modal-title fs-5" id="@assignTeamModalLabelId">
                                                        Assign Team to Team Manager
                                                    </h2>
                                                </div>

                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <form method="post"
                                                  asp-page-handler="AssignTeamToTeamManager"
                                                  asp-route-id="@user.Id">
                                                <div class="modal-body">
                                                    <p class="mb-3">
                                                        Assign a Team to <strong>@user.FullNameAsPerId</strong>.
                                                    </p>

                                                    <input type="hidden"
                                                           name="TeamManagerTeamInput.AssignmentId"
                                                           value="@roleAssignment.Id" />

                                                    <div>
                                                        <label class="form-label" for="teamManagerTeamInput-@roleAssignment.Id">
                                                            Team <span class="app-required">*</span>
                                                        </label>

                                                        <select name="TeamManagerTeamInput.TeamId"
                                                                id="teamManagerTeamInput-@roleAssignment.Id"
                                                                class="form-select"
                                                                required>
                                                            @foreach (var teamOption in Model.TeamOptions)
                                                            {
                                                                <option value="@teamOption.Value"
                                                                        disabled="@(teamOption.Disabled ? "disabled" : null)">
                                                                    @teamOption.Text
                                                                </option>
                                                            }
                                                        </select>

                                                        <div class="form-text">
                                                            Teams that already have 3 active verified Team Managers are disabled.
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="submit" class="btn btn-primary">
                                                        Assign Team
                                                    </button>

                                                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (canRemoveTeamFromTeamManager)
                            {
                                <div class="modal fade" id="@removeTeamModalId" tabindex="-1" aria-labelledby="@removeTeamModalLabelId" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content app-result-modal app-result-modal-danger">
                                            <div class="modal-header">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                                                    <h2 class="modal-title fs-5" id="@removeTeamModalLabelId">
                                                        Remove Team from Team Manager?
                                                    </h2>
                                                </div>

                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body">
                                                <p class="mb-2">
                                                    This will remove <strong>@roleAssignment.TeamDisplay</strong> from
                                                    <strong>@user.FullNameAsPerId</strong>.
                                                </p>

                                                <p class="mb-0 text-muted">
                                                    The user will keep the Team Manager role, but will no longer be assigned to this Team.
                                                </p>
                                            </div>

                                            <div class="modal-footer">
                                                <form method="post"
                                                      asp-page-handler="UnassignTeamFromTeamManager"
                                                      asp-route-id="@user.Id"
                                                      asp-route-assignmentId="@roleAssignment.Id">
                                                    <button type="submit" class="btn btn-danger">
                                                        Remove Team
                                                    </button>
                                                </form>

                                                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                                                    Keep Team
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                <hr class="my-4" />

                <h2>Assign Role</h2>
                <p class="text-muted">
                    Assign any active role to this user. Team Manager team assignment can be completed from this page after the role is assigned and verified.
                </p>

                <form method="post" asp-page-handler="AssignRole" asp-route-id="@user.Id">
                    <div class="mb-3">
                        <label asp-for="RoleInput.RoleCode" class="form-label">
                            Role <span class="app-required">*</span>
                        </label>
                        <select asp-for="RoleInput.RoleCode" asp-items="Model.RoleOptions" class="form-select"></select>
                        <span asp-validation-for="RoleInput.RoleCode" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-2">
                        <input asp-for="RoleInput.IsVerified" class="form-check-input" />
                        <label asp-for="RoleInput.IsVerified" class="form-check-label"></label>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RoleInput.IsPrimary" class="form-check-input" />
                        <label asp-for="RoleInput.IsPrimary" class="form-check-label"></label>
                        <span asp-validation-for="RoleInput.IsPrimary" class="text-danger small d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Assign Role
                    </button>
                </form>
            </div>

            <div class="app-card">
                <h2>Audit Information</h2>

                <div class="table-responsive">
                    <table class="table app-table align-middle">
                        <tbody>
                            <tr>
                                <th>Created At</th>
                                <td>@user.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                            <tr>
                                <th>Created By</th>
                                <td>
                                    @if (user.CreatedByUser != null)
                                    {
                                        <a asp-page="/Admin/UserProfiles/Details" asp-route-id="@user.CreatedByUser.Id">
                                            @user.CreatedByUser.DisplayName
                                        </a>
                                    }
                                    else if (user.CreatedBy != null)
                                    {
                                        <span class="text-muted">Unknown user (@user.CreatedBy)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Updated At</th>
                                <td>@(user.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Updated By</th>
                                <td>
                                    @if (user.UpdatedByUser != null)
                                    {
                                        <a asp-page="/Admin/UserProfiles/Details" asp-route-id="@user.UpdatedByUser.Id">
                                            @user.UpdatedByUser.DisplayName
                                        </a>
                                    }
                                    else if (user.UpdatedBy != null)
                                    {
                                        <span class="text-muted">Unknown user (@user.UpdatedBy)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (shouldShowRoleResultModal)
    {
        <div class="modal fade" id="roleAssignmentResultModal" tabindex="-1" aria-labelledby="roleAssignmentResultModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content app-result-modal @roleModalCssClass">
                    <div class="modal-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @roleModalIcon app-result-modal-icon" aria-hidden="true"></i>
                            <h2 class="modal-title fs-5" id="roleAssignmentResultModalLabel">
                                @Model.RoleAssignmentResultTitle
                            </h2>
                        </div>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="@(roleServerErrors.Count > 0 ? "mb-2" : "mb-0")">
                            @Model.RoleAssignmentResultMessage
                        </p>

                        @if (roleServerErrors.Count > 0)
                        {
                            <ul class="mb-0">
                                @foreach (var error in roleServerErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                            Okay
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (shouldShowRoleResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("roleAssignmentResultModal");

                if (!modalElement) {
                    return;
                }

                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        </script>
    }
}