@page "{id:guid}"
@model PbmEventPortal.Web.Pages.Admin.CompetitionYears.EditModel
@{
    ViewData["Title"] = "Edit Competition Year";

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowResultModal = Model.ResultIsSuccess.HasValue;
    var resultIsSuccess = Model.ResultIsSuccess == true;

    var modalCssClass = resultIsSuccess
        ? "app-result-modal-success"
        : "app-result-modal-danger";

    var modalIcon = resultIsSuccess
        ? "bi-check-circle-fill"
        : "bi-exclamation-triangle-fill";
}

<div class="app-page-header">
    <p class="app-eyebrow">Competition year setup</p>
    <h1>Edit Competition Year</h1>
    <p>
        Update this PBM event year and registration window.
    </p>
    <p class="app-required-legend">
        <span class="app-required">*</span> Mandatory field
    </p>
</div>

<div class="app-card">
    <form method="post" id="editCompetitionYearForm">
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.YearNo" class="form-label">
                    Year <span class="app-required">*</span>
                </label>
                <input asp-for="Input.YearNo"
                       class="form-control"
                       min="2000"
                       max="2100"
                       required />
                <span asp-validation-for="Input.YearNo" class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Input.DisplayName" class="form-label">
                    Display name <span class="app-required">*</span>
                </label>
                <input asp-for="Input.DisplayName"
                       class="form-control"
                       required />
                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.RegistrationOpenAt" class="form-label"></label>
                <input asp-for="Input.RegistrationOpenAt" class="form-control" />
                <span asp-validation-for="Input.RegistrationOpenAt" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.RegistrationCloseAt" class="form-label"></label>
                <input asp-for="Input.RegistrationCloseAt" class="form-control" />
                <span asp-validation-for="Input.RegistrationCloseAt" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <div class="form-check mt-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#cancelEditCompetitionYearModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#resetEditCompetitionYearModal">
                    Reset
                </button>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>
        </div>
    </form>
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="editCompetitionYearResultModal" tabindex="-1" aria-labelledby="editCompetitionYearResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>
                        <h2 class="modal-title fs-5" id="editCompetitionYearResultModalLabel">
                            @Model.ResultTitle
                        </h2>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="@(serverErrors.Count > 0 ? "mb-2" : "mb-0")">
                        @Model.ResultMessage
                    </p>

                    @if (serverErrors.Count > 0)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>

                <div class="modal-footer">
                    @if (resultIsSuccess)
                    {
                        <a class="btn btn-outline-danger" asp-page="/Admin/CompetitionYears/Index">
                            View All Competition Years
                        </a>

                        <a class="btn btn-primary"
                           asp-page="/Admin/CompetitionYears/Details"
                           asp-route-id="@Model.Input.Id">
                            View This Competition Year
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                            Okay, I’ll fix it
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="resetEditCompetitionYearModal" tabindex="-1" aria-labelledby="resetEditCompetitionYearModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="resetEditCompetitionYearModalLabel">
                        Reset changes?
                    </h2>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                This will discard unsaved changes and reload the saved competition year details.
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    Keep editing
                </button>

                <button type="button" class="btn btn-danger" id="confirmResetButton">
                    Reset changes
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelEditCompetitionYearModal" tabindex="-1" aria-labelledby="cancelEditCompetitionYearModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="cancelEditCompetitionYearModalLabel">
                        Cancel editing competition year?
                    </h2>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                Any unsaved changes on this page will be lost.
            </div>

            <div class="modal-footer">
                <a class="btn btn-danger"
                   asp-page="/Admin/CompetitionYears/Details"
                   asp-route-id="@Model.Input.Id">
                    Cancel editing
                </a>

                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    Stay here
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const confirmResetButton = document.getElementById("confirmResetButton");

            function resetFormToSavedValues() {
                window.location.href = window.location.pathname;
            }

            confirmResetButton?.addEventListener("click", resetFormToSavedValues);
        })();
    </script>

    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("editCompetitionYearResultModal");

                if (!modalElement) {
                    return;
                }

                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        </script>
    }
}
