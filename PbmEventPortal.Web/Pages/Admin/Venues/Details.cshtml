@page "{id:guid}"
@model PbmEventPortal.Web.Pages.Admin.Venues.DetailsModel
@{
    ViewData["Title"] = "View Venue";
    var venue = Model.Venue;
}

<div class="app-page-header">
    <p class="app-eyebrow">Event setup</p>
    <h1>View Venue</h1>
    <p>
        View venue details used for event scheduling and logistics.
    </p>

    @if (venue != null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/Venues/Index">
                Back to Venues
            </a>

            <a class="btn btn-primary btn-sm"
               asp-page="/Admin/Venues/Edit"
               asp-route-id="@venue.Id">
                Edit
            </a>
        </div>
    }
    else
    {
        <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/Venues/Index">
            Back to Venues
        </a>
    }
</div>

@if (venue == null)
{
    <div class="app-alert app-alert-danger">
        Venue not found.
    </div>
}
else
{
    <div class="app-card">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Competition year</label>
                <input type="text" class="form-control" value="@venue.CompetitionYearDisplay" disabled />
            </div>

            <div class="col-md-4">
                <label class="form-label">Venue code</label>
                <input type="text" class="form-control" value="@venue.Code" disabled />
            </div>

            <div class="col-md-4">
                <label class="form-label">Venue name</label>
                <input type="text" class="form-control" value="@venue.Name" disabled />
            </div>

            <div class="col-md-4">
                <label class="form-label">Location</label>
                <input type="text" class="form-control" value="@venue.LocationDisplay" disabled />
            </div>

            <div class="col-md-4">
                <label class="form-label">Capacity</label>
                <input type="text" class="form-control" value="@venue.CapacityDisplay" disabled />
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <div>
                    <span class="app-pill @(venue.IsActive ? string.Empty : "app-pill-danger")">
                        @venue.StatusDisplay
                    </span>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control" rows="4" disabled>@venue.NotesDisplay</textarea>
            </div>
        </div>
    </div>
}
