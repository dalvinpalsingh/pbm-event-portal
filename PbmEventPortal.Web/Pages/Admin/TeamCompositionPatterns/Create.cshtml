@page
@using System.Text.Json
@model PbmEventPortal.Web.Pages.Admin.TeamCompositionPatterns.CreateModel
@{
    ViewData["Title"] = "Add Team Composition Pattern";

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowResultModal = Model.ResultIsSuccess.HasValue;
    var resultIsSuccess = Model.ResultIsSuccess == true;
    var modalCssClass = resultIsSuccess ? "app-result-modal-success" : "app-result-modal-danger";
    var modalIcon = resultIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill";
    var categoryMetadataJson = JsonSerializer.Serialize(Model.LookupOptions.CategoryMetadata, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="app-page-header">
    <p class="app-eyebrow">Registration setup</p>
    <h1>Add Team Composition Pattern</h1>
    <p>Configure allowed Tahap slot combinations for team competition registrations.</p>
    <p class="app-required-legend"><span class="app-required">*</span> Mandatory field</p>
</div>

<div class="app-card">
    <form method="post" id="createTeamCompositionPatternForm">
        <input type="hidden" asp-for="Input.PatternCode" id="patternCodeHiddenInput" />
        <input type="hidden" asp-for="Input.AllowYoungerSubstitution" id="youngerSubstitutionHiddenInput" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.CompetitionCategoryId" class="form-label">Competition category <span class="app-required">*</span></label>
                <select asp-for="Input.CompetitionCategoryId" asp-items="Model.LookupOptions.CompetitionCategoryOptions" class="form-select" id="competitionCategorySelect" required></select>
                <span asp-validation-for="Input.CompetitionCategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="teamSizeDisplayInput">Team size</label>
                <input type="text" class="form-control" id="teamSizeDisplayInput" value="" disabled />
            </div>

            <div class="col-md-3">
                <label class="form-label" for="youngerSubstitutionDisplayInput">Younger substitution</label>
                <input type="text" class="form-control" id="youngerSubstitutionDisplayInput" value="" disabled />
            </div>

            <div class="col-12">
                <label class="form-label" for="patternCodeDisplayInput">Pattern code</label>
                <input type="text" class="form-control" id="patternCodeDisplayInput" value="" disabled />
                <div class="form-text">Generated from competition code, category, selected Tahap combination, and younger substitution rule. Tahap order is canonical, so T3 + T4 and T4 + T3 generate the same code.</div>
                <span asp-validation-for="Input.PatternCode" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <label class="form-label mb-0">Slots <span class="app-required">*</span></label>
                        <div class="form-text">Slot count is based on the selected competition category team size.</div>
                    </div>
                </div>
                <div class="row g-3" id="slotFieldsContainer">
                    @for (var i = 0; i < Model.LookupOptions.MaxTeamSize; i++)
                    {
                        <div class="col-md-4 team-composition-slot-field d-none" data-slot-index="@i">
                            <label class="form-label" for="slotTahapCode_@i">Slot @(i + 1) Tahap <span class="app-required">*</span></label>
                            <select class="form-select slot-tahap-select" id="slotTahapCode_@i" name="Input.SlotTahapCodes[@i]">
                                <option value="">Select Tahap...</option>
                                @foreach (var option in Model.LookupOptions.TahapOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Input.SlotTahapCodes[@i]" data-valmsg-replace="true"></span>
                        </div>
                    }
                </div>
                <p class="text-muted mb-0 d-none" id="noCategorySelectedHelpText">Select a competition category to show slot fields.</p>
            </div>

            <div class="col-md-6">
                <label class="form-label">Status</label>
                <div class="form-check mt-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Active pattern</label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="Input.Notes" class="form-label">Notes</label>
                <textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelCreateTeamCompositionPatternModal">Cancel</button>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#resetCreateTeamCompositionPatternModal">Reset</button>
            </div>
            <button type="submit" class="btn btn-primary">Add Pattern</button>
        </div>
    </form>
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="createTeamCompositionPatternResultModal" tabindex="-1" aria-labelledby="createTeamCompositionPatternResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>
                        <h2 class="modal-title fs-5" id="createTeamCompositionPatternResultModalLabel">@Model.ResultTitle</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="@(serverErrors.Count > 0 ? "mb-2" : "mb-0")">@Model.ResultMessage</p>
                    @if (serverErrors.Count > 0)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-danger" asp-page="/Admin/TeamCompositionPatterns/Index">View All Patterns</a>
                    @if (!resultIsSuccess)
                    {
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Okay, I’ll fix it</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="resetCreateTeamCompositionPatternModal" tabindex="-1" aria-labelledby="resetCreateTeamCompositionPatternModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="resetCreateTeamCompositionPatternModalLabel">Reset form?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">This will clear all entered team composition pattern details and return the form to its default state.</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Keep editing</button>
                <button type="button" class="btn btn-danger" id="confirmResetButton">Reset form</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelCreateTeamCompositionPatternModal" tabindex="-1" aria-labelledby="cancelCreateTeamCompositionPatternModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="cancelCreateTeamCompositionPatternModalLabel">Cancel adding pattern?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">Any details entered on this page will not be saved.</div>
            <div class="modal-footer">
                <a class="btn btn-danger" asp-page="/Admin/TeamCompositionPatterns/Index">Cancel adding pattern</a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Stay here</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const categoryMetadata = @Html.Raw(categoryMetadataJson);
            const form = document.getElementById("createTeamCompositionPatternForm");
            const categorySelect = document.getElementById("competitionCategorySelect");
            const teamSizeDisplayInput = document.getElementById("teamSizeDisplayInput");
            const youngerSubstitutionDisplayInput = document.getElementById("youngerSubstitutionDisplayInput");
            const youngerSubstitutionHiddenInput = document.getElementById("youngerSubstitutionHiddenInput");
            const patternCodeHiddenInput = document.getElementById("patternCodeHiddenInput");
            const patternCodeDisplayInput = document.getElementById("patternCodeDisplayInput");
            const noCategorySelectedHelpText = document.getElementById("noCategorySelectedHelpText");
            const confirmResetButton = document.getElementById("confirmResetButton");
            const slotFields = Array.from(document.querySelectorAll(".team-composition-slot-field"));
            const slotSelects = Array.from(document.querySelectorAll(".slot-tahap-select"));

            function getSelectedCategory() {
                const selectedId = categorySelect?.value ?? "";
                return categoryMetadata.find((category) => category.id.toLowerCase() === selectedId.toLowerCase()) ?? null;
            }

            function normalizeCodePart(value) {
                return (value ?? "").trim().toUpperCase().replace(/[^A-Z0-9]+/g, "_").replace(/_+/g, "_").replace(/^_+|_+$/g, "");
            }

            function toTahapPart(value) {
                return (value ?? "").trim().toUpperCase().replace("TAHAP_", "T");
            }

            function getTahapSortOrder(tahapPart) {
                const tahapNo = Number.parseInt((tahapPart ?? "").replace("T", ""), 10);
                return Number.isNaN(tahapNo) ? Number.MAX_SAFE_INTEGER : tahapNo;
            }

            function buildPatternCode(category) {
                if (!category) return "";

                const slotParts = slotSelects
                    .slice(0, category.teamSize)
                    .map((select) => toTahapPart(select.value))
                    .filter((value) => value.length > 0)
                    .sort((left, right) => {
                        const sortDiff = getTahapSortOrder(left) - getTahapSortOrder(right);
                        return sortDiff !== 0 ? sortDiff : left.localeCompare(right);
                    });

                if (slotParts.length !== category.teamSize) return "";

                const substitutionPart = category.allowYoungerSubstitution ? "YS_ALLOWED" : "YS_DISABLED";
                return `${normalizeCodePart(category.competitionCode)}_${normalizeCodePart(category.categoryCode)}_${slotParts.join("_")}_${substitutionPart}`;
            }

            function updateFields() {
                const category = getSelectedCategory();
                const teamSize = category?.teamSize ?? 0;

                if (teamSizeDisplayInput) teamSizeDisplayInput.value = category ? teamSize.toString() : "";
                if (youngerSubstitutionDisplayInput) youngerSubstitutionDisplayInput.value = category ? (category.allowYoungerSubstitution ? "Allowed" : "Disabled") : "";
                if (youngerSubstitutionHiddenInput) youngerSubstitutionHiddenInput.value = category?.allowYoungerSubstitution ? "true" : "false";

                slotFields.forEach((field, index) => {
                    const isVisible = index < teamSize;
                    field.classList.toggle("d-none", !isVisible);
                    const select = field.querySelector("select");
                    if (select) {
                        select.disabled = !isVisible;
                        select.required = isVisible;
                        if (!isVisible) select.value = "";
                    }
                });

                noCategorySelectedHelpText?.classList.toggle("d-none", Boolean(category));

                const generatedCode = buildPatternCode(category);
                if (patternCodeHiddenInput) patternCodeHiddenInput.value = generatedCode;
                if (patternCodeDisplayInput) patternCodeDisplayInput.value = generatedCode;
            }

            confirmResetButton?.addEventListener("click", () => {
                form?.reset();
                updateFields();
                bootstrap.Modal.getInstance(document.getElementById("resetCreateTeamCompositionPatternModal"))?.hide();
            });

            categorySelect?.addEventListener("change", updateFields);
            slotSelects.forEach((select) => select.addEventListener("change", updateFields));
            updateFields();
        })();
    </script>
    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("createTeamCompositionPatternResultModal");
                if (modalElement) new bootstrap.Modal(modalElement).show();
            });
        </script>
    }
}
