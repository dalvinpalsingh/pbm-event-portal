@page "{id:guid}"
@model PbmEventPortal.Web.Pages.Admin.RegistrationEntries.DetailsModel
@{
    ViewData["Title"] = "Registration Entry Details";
    var entry = Model.RegistrationEntry!;
}

<div class="app-page-header">
    <p class="app-eyebrow">Registration setup</p>
    <h1>Registration Entry Details</h1>
    <p>Review registration entry details, participants, status, approval information, and audit information.</p>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/RegistrationEntries/Index">
            Back to Registration Entries
        </a>

        <a class="btn btn-primary btn-sm" asp-page="/Admin/RegistrationEntries/Edit" asp-route-id="@entry.Id">
            Edit Entry
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="app-card">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Competition year</div>
                    <div class="fw-semibold">@entry.CompetitionYearDisplay</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Team</div>
                    <div class="fw-semibold">@entry.TeamDisplay</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Competition</div>
                    <div class="fw-semibold">@entry.CompetitionDisplay</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Category</div>
                    <span class="app-pill">@entry.CategoryDisplay</span>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Entry type</div>
                    <span class="app-pill">@entry.EventType</span>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Status</div>
                    <span class="app-pill @(entry.IsActive ? string.Empty : "app-pill-danger")">@entry.StatusDisplay</span>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Approved by</div>
                    <div class="fw-semibold">@entry.ApprovedByDisplay</div>
                </div>
                <div class="col-md-12">
                    <div class="text-muted small">Entry name</div>
                    <div class="fw-semibold">@entry.EntryNameDisplay</div>
                </div>
                <div class="col-md-12">
                    <div class="text-muted small">Rejected reason</div>
                    <div>@entry.RejectedReasonDisplay</div>
                </div>
                <div class="col-md-12">
                    <div class="text-muted small">Notes</div>
                    <div>@entry.NotesDisplay</div>
                </div>
            </div>
        </div>

        <div class="app-card mt-3">
            <h2>Audit information</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Created at</div>
                    <div>@entry.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Created by</div>
                    <div>@entry.CreatedByDisplay</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Updated at</div>
                    <div>@(entry.UpdatedAt.HasValue ? entry.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Not updated yet")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Updated by</div>
                    <div>@entry.UpdatedByDisplay</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="app-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="mb-1">Participants</h2>
                    <p class="mb-0 text-muted">Participants linked to this registration entry.</p>
                </div>
                <span class="app-pill">@entry.Participants.Count</span>
            </div>

            @if (entry.Participants.Count == 0)
            {
                <p class="text-muted mb-0">No participants linked.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var participant in entry.Participants)
                    {
                        <div class="app-mini-card">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">@participant.ParticipantOrder. @participant.ParticipantName</div>
                                    <div class="text-muted small">@participant.ParticipantTeamCode / @participant.ParticipantTahapCode</div>
                                </div>
                                <span class="app-pill @(participant.IsActive ? string.Empty : "app-pill-danger")">@participant.StatusDisplay</span>
                            </div>
                            <div class="mt-2">
                                <a class="btn btn-primary btn-sm" asp-page="/Admin/Participants/Details" asp-route-id="@participant.ParticipantId">
                                    View Participant
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
