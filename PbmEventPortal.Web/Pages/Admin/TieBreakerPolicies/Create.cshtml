@page
@using System.Text.Json
@model PbmEventPortal.Web.Pages.Admin.TieBreakerPolicies.CreateModel
@{
    ViewData["Title"] = "Add Tie-Breaker Policy";

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowResultModal = Model.ResultIsSuccess.HasValue;
    var resultIsSuccess = Model.ResultIsSuccess == true;

    var modalCssClass = resultIsSuccess
        ? "app-result-modal-success"
        : "app-result-modal-danger";

    var modalIcon = resultIsSuccess
        ? "bi-check-circle-fill"
        : "bi-exclamation-triangle-fill";

    var ruleCodeOptionsJson = JsonSerializer.Serialize(
        Model.RuleCodeOptions,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });

    var sortDirectionOptionsJson = JsonSerializer.Serialize(
        Model.SortDirectionOptions,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<div class="app-page-header">
    <p class="app-eyebrow">Event setup</p>
    <h1>Add Tie-Breaker Policy</h1>
    <p>
        Configure rules used when results have equal scores or points.
    </p>
    <p class="app-required-legend">
        <span class="app-required">*</span> Mandatory field
    </p>
</div>

<div class="app-card">
    <form method="post" id="createTieBreakerPolicyForm">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.CompetitionYearId" class="form-label">
                    Competition year <span class="app-required">*</span>
                </label>
                <select asp-for="Input.CompetitionYearId" asp-items="Model.CompetitionYearOptions" class="form-select" required></select>
                <span asp-validation-for="Input.CompetitionYearId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.PolicyName" class="form-label">
                    Policy name <span class="app-required">*</span>
                </label>
                <input asp-for="Input.PolicyName" class="form-control" maxlength="100" required />
                <span asp-validation-for="Input.PolicyName" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.AppliesTo" class="form-label">
                    Applies to <span class="app-required">*</span>
                </label>
                <select asp-for="Input.AppliesTo" asp-items="Model.AppliesToOptions" class="form-select" required></select>
                <span asp-validation-for="Input.AppliesTo" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.RuleCount" class="form-label">
                    Rule count <span class="app-required">*</span>
                </label>
                <select asp-for="Input.RuleCount" class="form-select" id="ruleCountSelect" required>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
                <span asp-validation-for="Input.RuleCount" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <div class="form-check mt-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="col-12">
                <div class="mb-2">
                    <h2 class="h5 mb-1">Tie-Breaker Rules</h2>
                    <p class="text-muted mb-0">
                        Rules are applied in priority order. Rule rows are generated based on the selected rule count.
                    </p>
                </div>

                <div class="row g-3" id="tieBreakerRulesContainer">
                    @for (var index = 0; index < Model.Input.Rules.Count; index++)
                    {
                        <div class="col-12 col-md-6 col-xl-4" data-tie-breaker-rule-column>
                            <div class="scoring-criterion-box h-100">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">
                                            Priority <span class="app-required">*</span>
                                        </label>
                                        <input asp-for="Input.Rules[index].PriorityNo" class="form-control" readonly />
                                        <span asp-validation-for="Input.Rules[index].PriorityNo" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Input.Rules[index].RuleCode" class="form-label">
                                            Rule <span class="app-required">*</span>
                                        </label>
                                        <select asp-for="Input.Rules[index].RuleCode" asp-items="Model.RuleCodeOptions" class="form-select" required></select>
                                        <span asp-validation-for="Input.Rules[index].RuleCode" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Input.Rules[index].SortDirection" class="form-label">
                                            Sort direction <span class="app-required">*</span>
                                        </label>
                                        <select asp-for="Input.Rules[index].SortDirection" asp-items="Model.SortDirectionOptions" class="form-select" required></select>
                                        <span asp-validation-for="Input.Rules[index].SortDirection" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check">
                                            <input asp-for="Input.Rules[index].IsActive" class="form-check-input" />
                                            <label asp-for="Input.Rules[index].IsActive" class="form-check-label">Active</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#cancelCreateTieBreakerPolicyModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#resetCreateTieBreakerPolicyModal">
                    Reset
                </button>
            </div>

            <button type="submit" class="btn btn-primary">
                Add Tie-Breaker Policy
            </button>
        </div>
    </form>
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="createTieBreakerPolicyResultModal" tabindex="-1" aria-labelledby="createTieBreakerPolicyResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>
                        <h2 class="modal-title fs-5" id="createTieBreakerPolicyResultModalLabel">
                            @Model.ResultTitle
                        </h2>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="@(serverErrors.Count > 0 ? "mb-2" : "mb-0")">
                        @Model.ResultMessage
                    </p>

                    @if (serverErrors.Count > 0)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>

                <div class="modal-footer">
                    <a class="btn btn-outline-danger" asp-page="/Admin/TieBreakerPolicies/Index">
                        View All Tie-Breaker Policies
                    </a>

                    @if (!resultIsSuccess)
                    {
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                            Okay, I’ll fix it
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="resetCreateTieBreakerPolicyModal" tabindex="-1" aria-labelledby="resetCreateTieBreakerPolicyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="resetCreateTieBreakerPolicyModalLabel">
                        Reset form?
                    </h2>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                This will clear all entered tie-breaker policy details and return the form to its default state.
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    Keep editing
                </button>

                <button type="button" class="btn btn-danger" id="confirmResetButton">
                    Reset form
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelCreateTieBreakerPolicyModal" tabindex="-1" aria-labelledby="cancelCreateTieBreakerPolicyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="cancelCreateTieBreakerPolicyModalLabel">
                        Cancel adding tie-breaker policy?
                    </h2>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                Any details entered on this page will not be saved.
            </div>

            <div class="modal-footer">
                <a class="btn btn-danger" asp-page="/Admin/TieBreakerPolicies/Index">
                    Cancel adding tie-breaker policy
                </a>

                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    Stay here
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const ruleCodeOptions = @Html.Raw(ruleCodeOptionsJson);
            const sortDirectionOptions = @Html.Raw(sortDirectionOptionsJson);
            const form = document.getElementById("createTieBreakerPolicyForm");
            const ruleCountSelect = document.getElementById("ruleCountSelect");
            const container = document.getElementById("tieBreakerRulesContainer");
            const confirmResetButton = document.getElementById("confirmResetButton");

            function getRuleCount() {
                const value = Number(ruleCountSelect?.value ?? 1);
                return Number.isNaN(value) ? 1 : value;
            }

            function buildOptions(options, selectedValue) {
                return options.map((option) => {
                    const selected = option.value === selectedValue ? " selected" : "";
                    return `<option value="${option.value}"${selected}>${option.text}</option>`;
                }).join("");
            }

            function createRuleColumn(priorityNo) {
                const selectedRuleCode = priorityNo === 1 ? "TOTAL_POINTS" : "";
                const column = document.createElement("div");
                column.className = "col-12 col-md-6 col-xl-4";
                column.dataset.tieBreakerRuleColumn = "true";
                column.innerHTML = `
                    <div class="scoring-criterion-box h-100">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Priority <span class="app-required">*</span></label>
                                <input type="number" class="form-control" data-priority-no-input readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Rule <span class="app-required">*</span></label>
                                <select class="form-select" data-rule-code-input required>
                                    ${buildOptions(ruleCodeOptions, selectedRuleCode)}
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Sort direction <span class="app-required">*</span></label>
                                <select class="form-select" data-sort-direction-input required>
                                    ${buildOptions(sortDirectionOptions, "DESC")}
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" data-is-active-input value="true" checked />
                                    <input type="hidden" data-is-active-hidden-input value="false" />
                                    <label class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                column.querySelector("[data-priority-no-input]").value = priorityNo.toString();

                return column;
            }

            function nameInputs() {
                const columns = Array.from(container?.querySelectorAll("[data-tie-breaker-rule-column]") ?? []);

                columns.forEach((column, index) => {
                    column.querySelector("[data-priority-no-input]").name = `Input.Rules[${index}].PriorityNo`;
                    column.querySelector("[data-rule-code-input]").name = `Input.Rules[${index}].RuleCode`;
                    column.querySelector("[data-sort-direction-input]").name = `Input.Rules[${index}].SortDirection`;
                    column.querySelector("[data-is-active-input]").name = `Input.Rules[${index}].IsActive`;
                    column.querySelector("[data-is-active-hidden-input]").name = `Input.Rules[${index}].IsActive`;
                });
            }

            function renderRules() {
                if (!container) {
                    return;
                }

                const ruleCount = getRuleCount();
                container.innerHTML = "";

                for (let priorityNo = 1; priorityNo <= ruleCount; priorityNo += 1) {
                    container.appendChild(createRuleColumn(priorityNo));
                }

                nameInputs();
            }

            function resetFormToDefaults() {
                form?.reset();
                renderRules();

                const resetModalElement = document.getElementById("resetCreateTieBreakerPolicyModal");
                const resetModal = bootstrap.Modal.getInstance(resetModalElement);

                resetModal?.hide();
            }

            ruleCountSelect?.addEventListener("change", renderRules);
            confirmResetButton?.addEventListener("click", resetFormToDefaults);
        })();
    </script>

    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("createTieBreakerPolicyResultModal");

                if (!modalElement) {
                    return;
                }

                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        </script>
    }
}
