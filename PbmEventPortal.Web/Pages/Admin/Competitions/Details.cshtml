@page "{id:guid}"
@model PbmEventPortal.Web.Pages.Admin.Competitions.DetailsModel
@{
    ViewData["Title"] = "Competition Details";
    var competition = Model.Competition;
}

<div class="app-page-header">
    <p class="app-eyebrow">Event setup</p>
    <h1>Competition Details</h1>
    <p>
        View PBM competition setup, judging requirements, categories, and scoring progress.
    </p>

    @if (competition != null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/Competitions/Index">
                Back to Competitions
            </a>

            <a class="btn btn-primary btn-sm"
               asp-page="/Admin/Competitions/Edit"
               asp-route-id="@competition.Id">
                Edit Competition
            </a>
        </div>
    }
    else
    {
        <a class="btn btn-outline-danger btn-sm" asp-page="/Admin/Competitions/Index">
            Back to Competitions
        </a>
    }
</div>

@if (competition == null)
{
    <div class="app-alert app-alert-danger">
        Competition not found.
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="app-card">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <h2 class="mb-1">@competition.NameEnglish</h2>

                        @if (!string.IsNullOrWhiteSpace(competition.NameGurmukhi))
                        {
                            <p class="mb-0 text-muted">@competition.NameGurmukhi</p>
                        }
                    </div>

                    <span class="app-pill">@competition.StatusDisplay</span>
                </div>

                <div class="table-responsive">
                    <table class="table app-table align-middle">
                        <tbody>
                            <tr>
                                <th>Competition ID</th>
                                <td>@competition.Id</td>
                            </tr>
                            <tr>
                                <th>Competition Year</th>
                                <td>
                                    <a asp-page="/Admin/CompetitionYears/Details" asp-route-id="@competition.CompetitionYearId">
                                        @competition.CompetitionYearDisplay
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <th>Code</th>
                                <td>
                                    <span class="app-pill">@competition.Code</span>
                                </td>
                            </tr>
                            <tr>
                                <th>English Name</th>
                                <td>@competition.NameEnglish</td>
                            </tr>
                            <tr>
                                <th>Gurmukhi Name</th>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(competition.NameGurmukhi))
                                    {
                                        @competition.NameGurmukhi
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Competition Type</th>
                                <td>@competition.CompetitionType</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>@competition.StatusDisplay</td>
                            </tr>
                            <tr>
                                <th>Notes</th>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(competition.Notes))
                                    {
                                        @competition.Notes
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="app-card mt-3">
                <h2>Setup Summary</h2>
                <p class="text-muted">
                    Current setup values and related records for this competition.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="app-mini-card h-100">
                            <div class="text-muted small">Scoring Criteria</div>
                            <div class="fs-4 fw-semibold">@competition.ScoringCriteriaCount / @competition.CriteriaCount</div>
                            <div class="text-muted small">configured / expected</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="app-mini-card h-100">
                            <div class="text-muted small">Judge Requirement</div>
                            <div class="fs-4 fw-semibold">@competition.JudgeRangeDisplay</div>
                            <div class="text-muted small">minimum / maximum judges</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="app-mini-card h-100">
                            <div class="text-muted small">Competition Categories</div>
                            <div class="fs-4 fw-semibold">@competition.CategoryCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="app-card mb-3">
                <h2>Next Setup Areas</h2>
                <p class="text-muted">
                    These related setup areas will be enabled in upcoming steps.
                </p>

                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-outline-secondary" disabled>
                        Competition Categories
                    </button>

                    <button type="button" class="btn btn-outline-secondary" disabled>
                        Scoring Criteria
                    </button>

                    <button type="button" class="btn btn-outline-secondary" disabled>
                        Judge Assignments
                    </button>
                </div>
            </div>

            <div class="app-card">
                <h2>Audit Information</h2>

                <div class="table-responsive">
                    <table class="table app-table align-middle">
                        <tbody>
                            <tr>
                                <th>Created At</th>
                                <td>@competition.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                            <tr>
                                <th>Created By</th>
                                <td>
                                    @if (competition.CreatedByUser != null)
                                    {
                                        <a asp-page="/Admin/UserProfiles/Details" asp-route-id="@competition.CreatedByUser.Id">
                                            @competition.CreatedByUser.DisplayName
                                        </a>
                                    }
                                    else if (competition.CreatedBy != null)
                                    {
                                        <span class="text-muted">Unknown user (@competition.CreatedBy)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Updated At</th>
                                <td>@(competition.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Updated By</th>
                                <td>
                                    @if (competition.UpdatedByUser != null)
                                    {
                                        <a asp-page="/Admin/UserProfiles/Details" asp-route-id="@competition.UpdatedByUser.Id">
                                            @competition.UpdatedByUser.DisplayName
                                        </a>
                                    }
                                    else if (competition.UpdatedBy != null)
                                    {
                                        <span class="text-muted">Unknown user (@competition.UpdatedBy)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
