@page
@model PbmEventPortal.Web.Pages.Admin.JudgeAssignments.CreateModel
@{
    ViewData["Title"] = "Assign Judge";

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowResultModal = Model.ResultIsSuccess.HasValue;
    var resultIsSuccess = Model.ResultIsSuccess == true;
    var modalCssClass = resultIsSuccess ? "app-result-modal-success" : "app-result-modal-danger";
    var modalIcon = resultIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill";
}

<div class="app-page-header">
    <p class="app-eyebrow">Event setup</p>
    <h1>Assign Judge</h1>
    <p>Assign an active verified Judge user to a competition category, optional schedule session, and optional criterion.</p>
    <p class="app-required-legend"><span class="app-required">*</span> Mandatory field</p>
</div>

<div class="app-card">
    <form method="post" id="createJudgeAssignmentForm">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.CompetitionCategoryId" class="form-label">Competition category <span class="app-required">*</span></label>
                <select asp-for="Input.CompetitionCategoryId" asp-items="Model.CompetitionCategoryOptions" class="form-select" required></select>
                <span asp-validation-for="Input.CompetitionCategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.JudgeUserId" class="form-label">Judge <span class="app-required">*</span></label>
                <select asp-for="Input.JudgeUserId" asp-items="Model.JudgeOptions" class="form-select" required></select>
                <span asp-validation-for="Input.JudgeUserId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.CriterionId" class="form-label">Scoring criterion</label>
                <select asp-for="Input.CriterionId" asp-items="Model.CriterionOptions" class="form-select"></select>
                <div class="form-text">Choose “All criteria” for a general judge assignment.</div>
                <span asp-validation-for="Input.CriterionId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.ScheduleItemId" class="form-label">Schedule item</label>
                <select asp-for="Input.ScheduleItemId" asp-items="Model.ScheduleItemOptions" class="form-select"></select>
                <div class="form-text">Only competition schedule items are valid.</div>
                <span asp-validation-for="Input.ScheduleItemId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <div class="form-check mt-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="Input.Notes" class="form-label">Notes</label>
                <textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="alert alert-info mt-4 mb-0">
            If the selected category has no active verified Judge users yet, assign the JUDGE role through User Access first, then return here.
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelCreateJudgeAssignmentModal">Cancel</button>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#resetCreateJudgeAssignmentModal">Reset</button>
            </div>
            <button type="submit" class="btn btn-primary">Assign Judge</button>
        </div>
    </form>
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="createJudgeAssignmentResultModal" tabindex="-1" aria-labelledby="createJudgeAssignmentResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>
                        <h2 class="modal-title fs-5" id="createJudgeAssignmentResultModalLabel">@Model.ResultTitle</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="@(serverErrors.Count > 0 ? "mb-2" : "mb-0")">@Model.ResultMessage</p>
                    @if (serverErrors.Count > 0)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-danger" asp-page="/Admin/JudgeAssignments/Index">View All Assignments</a>
                    @if (resultIsSuccess && Model.CreatedJudgeAssignmentId.HasValue)
                    {
                        <a class="btn btn-primary" asp-page="/Admin/JudgeAssignments/Details" asp-route-id="@Model.CreatedJudgeAssignmentId">View Assignment</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Okay, I’ll fix it</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="resetCreateJudgeAssignmentModal" tabindex="-1" aria-labelledby="resetCreateJudgeAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="resetCreateJudgeAssignmentModalLabel">Reset form?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">This will clear all entered judge assignment details and return the form to its default state.</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Keep editing</button>
                <button type="button" class="btn btn-danger" id="confirmResetButton">Reset form</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelCreateJudgeAssignmentModal" tabindex="-1" aria-labelledby="cancelCreateJudgeAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="cancelCreateJudgeAssignmentModalLabel">Cancel assigning judge?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">Any details entered on this page will not be saved.</div>
            <div class="modal-footer">
                <a class="btn btn-danger" asp-page="/Admin/JudgeAssignments/Index">Cancel assigning judge</a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Stay here</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("createJudgeAssignmentForm");
            const confirmResetButton = document.getElementById("confirmResetButton");
            confirmResetButton?.addEventListener("click", () => {
                form?.reset();
                bootstrap.Modal.getInstance(document.getElementById("resetCreateJudgeAssignmentModal"))?.hide();
            });
        })();
    </script>
    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("createJudgeAssignmentResultModal");
                if (modalElement) new bootstrap.Modal(modalElement).show();
            });
        </script>
    }
}
