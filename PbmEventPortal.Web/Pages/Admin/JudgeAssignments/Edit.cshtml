@page "{id:guid}"
@model PbmEventPortal.Web.Pages.Admin.JudgeAssignments.EditModel
@{
    ViewData["Title"] = "Edit Judge Assignment";

    var serverErrors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();

    var shouldShowResultModal = Model.ResultIsSuccess.HasValue;
    var resultIsSuccess = Model.ResultIsSuccess == true;
    var modalCssClass = resultIsSuccess ? "app-result-modal-success" : "app-result-modal-danger";
    var modalIcon = resultIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill";
}

<div class="app-page-header">
    <p class="app-eyebrow">Event setup</p>
    <h1>Edit Judge Assignment</h1>
    <p>Update judge assignment details, or deactivate/reactivate the assignment.</p>
</div>

<div class="app-card">
    <form method="post" id="editJudgeAssignmentForm">
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.CompetitionCategoryId" class="form-label">Competition category <span class="app-required">*</span></label>
                <select asp-for="Input.CompetitionCategoryId" asp-items="Model.CompetitionCategoryOptions" class="form-select" required></select>
                <span asp-validation-for="Input.CompetitionCategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.JudgeUserId" class="form-label">Judge <span class="app-required">*</span></label>
                <select asp-for="Input.JudgeUserId" asp-items="Model.JudgeOptions" class="form-select" required></select>
                <span asp-validation-for="Input.JudgeUserId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.CriterionId" class="form-label">Scoring criterion</label>
                <select asp-for="Input.CriterionId" asp-items="Model.CriterionOptions" class="form-select"></select>
                <span asp-validation-for="Input.CriterionId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.ScheduleItemId" class="form-label">Schedule item</label>
                <select asp-for="Input.ScheduleItemId" asp-items="Model.ScheduleItemOptions" class="form-select"></select>
                <span asp-validation-for="Input.ScheduleItemId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Status</label>
                <div class="form-check mt-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="Input.Notes" class="form-label">Notes</label>
                <textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelEditJudgeAssignmentModal">Cancel</button>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#resetEditJudgeAssignmentModal">Reset</button>
            </div>
            <button type="submit" class="btn btn-primary">Save Assignment</button>
        </div>
    </form>
</div>

@if (shouldShowResultModal)
{
    <div class="modal fade" id="editJudgeAssignmentResultModal" tabindex="-1" aria-labelledby="editJudgeAssignmentResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-result-modal @modalCssClass">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @modalIcon app-result-modal-icon" aria-hidden="true"></i>
                        <h2 class="modal-title fs-5" id="editJudgeAssignmentResultModalLabel">@Model.ResultTitle</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="@(serverErrors.Count > 0 ? "mb-2" : "mb-0")">@Model.ResultMessage</p>
                    @if (serverErrors.Count > 0)
                    {
                        <ul class="mb-0">
                            @foreach (var error in serverErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-danger" asp-page="/Admin/JudgeAssignments/Index">View All Assignments</a>
                    @if (!resultIsSuccess)
                    {
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Okay, I’ll fix it</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="resetEditJudgeAssignmentModal" tabindex="-1" aria-labelledby="resetEditJudgeAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="resetEditJudgeAssignmentModalLabel">Reset changes?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">This will reset the judge assignment fields back to the last loaded values.</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Keep editing</button>
                <button type="button" class="btn btn-danger" id="confirmResetButton">Reset changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelEditJudgeAssignmentModal" tabindex="-1" aria-labelledby="cancelEditJudgeAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-result-modal app-result-modal-danger">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill app-result-modal-icon" aria-hidden="true"></i>
                    <h2 class="modal-title fs-5" id="cancelEditJudgeAssignmentModalLabel">Cancel editing assignment?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">Any unsaved changes on this page will be lost.</div>
            <div class="modal-footer">
                <a class="btn btn-danger" asp-page="/Admin/JudgeAssignments/Details" asp-route-id="@Model.Input.Id">Cancel editing</a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Stay here</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("editJudgeAssignmentForm");
            const confirmResetButton = document.getElementById("confirmResetButton");
            confirmResetButton?.addEventListener("click", () => {
                form?.reset();
                bootstrap.Modal.getInstance(document.getElementById("resetEditJudgeAssignmentModal"))?.hide();
            });
        })();
    </script>
    @if (shouldShowResultModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("editJudgeAssignmentResultModal");
                if (modalElement) new bootstrap.Modal(modalElement).show();
            });
        </script>
    }
}
